<%# UC-2 Log In page %>
<%- include('partials/header', { title: 'Log in' }) %>

<h1>Log in</h1>

<%# Messages use the escaped output tag, so any text is HTML-escaped %>
<% if (registered) { %><p class="notice">Account created. You can now log in.</p><% } %>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

<form method="post" action="/login" class="auth">
  <%# Hidden field: the page the user wanted before logging in %>
  <input type="hidden" name="next" value="<%= next %>">

  <label for="username">Username</label>
  <input id="username" name="username" autocomplete="username" required>

  <label for="password">Password</label>
  <input id="password" name="password" type="password" autocomplete="current-password" required>

  <button type="submit">Log in</button>
</form>

<p>No account? <a href="/register">Register</a></p>

<%- include('partials/footer') %>